# Copiar a .env y completar. .env está gitignoreado — los secrets NUNCA van a git ni a appsettings.

# Connection string de Postgres 17 (env ConnectionStrings__pg)
PG_CONN=Host=localhost;Port=5432;Database=papasur;Username=postgres;Password=postgres;SSL Mode=Disable

# Migraciones EF automáticas al arrancar (true en dev/test; false para aplicar a mano en prod)
Ef__AutoMigrate=true

# JWT (HS256). Key simétrica >= 32 bytes, OBLIGATORIA fuera de Development.
Jwt__SymmetricKey=
Jwt__Issuer=papasur
Jwt__Audience=papasur
# Vigencia del access token en minutos (default 480 = 8 h)
Jwt__ExpirationMinutes=480

# Admin inicial: se crea al arrancar SOLO si no hay ningún usuario.
# Sin esto (fuera de Development) no se crea nadie y no habría con quién loguearse.
Seed__AdminEmail=
Seed__AdminPassword=
Seed__AdminEmployeeNumber=0001

# CORS: orígenes permitidos del front/backoffice (fail-closed si queda vacío fuera de dev)
Cors__AllowedOrigins__0=
Cors__AllowedOrigins__1=

# Rate limiting global por IP
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=10

# Postgres local (docker-compose.override.yml)
POSTGRES_DB=papasur
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Registry Docker (deploy)
DOCKER_REGISTRY=registry.example.com:5000
API_IMAGE_TAG=test
